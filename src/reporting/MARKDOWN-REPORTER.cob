>>SOURCE FORMAT FREE
*> =====================================================================
*> FIELDLEDGER - MARKDOWN-REPORTER.cob
*> Generates GitHub-readable scientific report (report.md) covering
*> study details, provenance, validation, data quality & missingness,
*> site summaries, BACI results, bootstrap & LOSO sensitivity, warnings,
*> transparent methodology, scientific limitations, and reproducibility.
*> =====================================================================
IDENTIFICATION DIVISION.
PROGRAM-ID. MARKDOWN-REPORTER.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT F-MD ASSIGN TO DYNAMIC WS-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS.

DATA DIVISION.
FILE SECTION.
FD F-MD.
01 F-MD-REC                 PIC X(2048).

WORKING-STORAGE SECTION.
COPY "LIMITS.cpy".
COPY "RUN-CONFIG.cpy".
COPY "STUDY-RECORD.cpy".
COPY "SOURCE-RECORD.cpy".
COPY "SITE-RECORD.cpy".
COPY "SURVEY-RECORD.cpy".
COPY "OBSERVATION-RECORD.cpy".
COPY "ERROR-RECORD.cpy".
COPY "BACI-RESULT.cpy".
COPY "UTILS-IFACE.cpy".

01 WS-FILE-PATH             PIC X(512).
01 WS-FS                    PIC XX.
01 WS-WRITE-OK              PIC X(1).
01 WS-LINE                  PIC X(2048).
01 WS-I                     PIC 9(9) COMP-5.
01 WS-WARN-FOUND            PIC X(1).
01 WS-N1                    PIC X(32).
01 WS-N2                    PIC X(32).
01 WS-N3                    PIC X(32).
01 WS-N4                    PIC X(32).
01 WS-N5                    PIC X(32).
01 WS-N6                    PIC X(32).
01 WS-N7                    PIC X(32).
01 WS-N8                    PIC X(32).
01 WS-N9                    PIC X(32).
01 WS-CI-TXT                PIC X(64).
01 WS-LOSO-TXT              PIC X(96).

LINKAGE SECTION.
01 L-MD-RC                  PIC S9(4) COMP-5.

PROCEDURE DIVISION USING L-MD-RC.
MAIN-MD.
    MOVE FL-EXIT-OK TO L-MD-RC
    MOVE "Y" TO WS-WRITE-OK

    INITIALIZE CFG-REQ
    MOVE "ENSURE-DIR" TO CREQ-OP
    MOVE CFG-OUT-PATH TO CREQ-PATH-A
    CALL "CONFIGURATION" USING CFG-REQ

    INITIALIZE CFG-REQ
    MOVE "JOIN-PATH"  TO CREQ-OP
    MOVE CFG-OUT-PATH TO CREQ-PATH-A
    MOVE "report.md"  TO CREQ-PATH-B
    CALL "CONFIGURATION" USING CFG-REQ
    MOVE CREQ-PATH-OUT TO WS-FILE-PATH

    OPEN OUTPUT F-MD
    IF WS-FS NOT = "00"
        PERFORM MARK-FAIL
        MOVE FL-EXIT-IO-ERR TO L-MD-RC
        GOBACK
    END-IF

    *> Header & Study Metadata
    STRING "# FIELDLEDGER Scientific Report: "
           FUNCTION TRIM(ST-STUDY-TITLE)
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN
    MOVE "> **Accountability Notice:** This report was generated deterministically by FIELDLEDGER "
        TO WS-LINE
    STRING "> **Accountability Notice:** Generated by **FIELDLEDGER v"
           FL-APP-VERSION "** (" FL-COMPILER-LABEL "). "
           "Version 1 estimates effort-standardised observation rates (`detections_per_hour`), "
           "not true ecological abundance or detection-corrected occupancy."
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN

    MOVE "## 1. Study Details" TO WS-LINE PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN
    MOVE "| Field | Value |" TO WS-LINE PERFORM W-LN
    MOVE "|---|---|" TO WS-LINE PERFORM W-LN
    STRING "| **Study ID** | `" FUNCTION TRIM(ST-STUDY-ID) "` |"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    STRING "| **Title** | " FUNCTION TRIM(ST-STUDY-TITLE) " |"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    STRING "| **Study Design** | " FUNCTION TRIM(ST-STUDY-DESIGN) " |"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    STRING "| **Primary Outcome** | " FUNCTION TRIM(ST-PRIMARY-OUTCOME)
           " (`" FUNCTION TRIM(ST-PRIMARY-UNIT) "`) |"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    STRING "| **Description** | " FUNCTION TRIM(ST-DESCRIPTION) " |"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    STRING "| **Run ID** | `" FUNCTION TRIM(CFG-RUN-ID) "` |"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    STRING "| **Execution Timestamp** | `" FUNCTION TRIM(CFG-RUN-TIMESTAMP) "` |"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN

    *> Section 2: Data Provenance
    MOVE "## 2. Data Provenance & Integrity" TO WS-LINE PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN
    STRING "- **Input SHA-256 Manifest Status:** `"
           FUNCTION TRIM(CFG-MANIFEST-STATUS) "`"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    IF FUNCTION TRIM(CFG-MANIFEST-DATE) NOT = SPACES
        STRING "- **Manifest Generated:** `"
               FUNCTION TRIM(CFG-MANIFEST-DATE) "`"
               DELIMITED BY SIZE INTO WS-LINE
        END-STRING
        PERFORM W-LN
    END-IF
    MOVE "- **Source Verification Notice:** Presence of a source URL in `sources.csv` records provenance only; URLs are NOT externally verified by FIELDLEDGER."
        TO WS-LINE PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN

    IF SRC-COUNT > 0
        MOVE "| Source ID | Type | Title | Organisation | Licence | Accessed |"
            TO WS-LINE PERFORM W-LN
        MOVE "|---|---|---|---|---|---|" TO WS-LINE PERFORM W-LN
        PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SRC-COUNT OR WS-I > 50
            STRING "| `" FUNCTION TRIM(SRC-ID(WS-I)) "` | "
                   FUNCTION TRIM(SRC-TYPE(WS-I)) " | "
                   FUNCTION TRIM(SRC-TITLE(WS-I)) " | "
                   FUNCTION TRIM(SRC-ORG(WS-I)) " | "
                   FUNCTION TRIM(SRC-LICENCE(WS-I)) " | "
                   FUNCTION TRIM(SRC-ACCESSED-DATE(WS-I)) " |"
                   DELIMITED BY SIZE INTO WS-LINE
            END-STRING
            PERFORM W-LN
        END-PERFORM
        MOVE " " TO WS-LINE PERFORM W-LN
    END-IF

    *> Section 3: Validation & Data Quality
    MOVE "## 3. Validation & Data Quality Summary" TO WS-LINE PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN
    MOVE "| Metric | Value |" TO WS-LINE PERFORM W-LN
    MOVE "|---|---:|" TO WS-LINE PERFORM W-LN

    MOVE ERR-ERROR-CNT TO NREQ-INT-VAL PERFORM FMT-I1
    STRING "| Validation Errors | " FUNCTION TRIM(WS-N1) " |"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    MOVE ERR-WARN-CNT TO NREQ-INT-VAL PERFORM FMT-I1
    STRING "| Warnings | " FUNCTION TRIM(WS-N1) " |"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    MOVE SITE-COUNT TO NREQ-INT-VAL PERFORM FMT-I1
    MOVE SITE-IMPACT-TOTAL TO NREQ-INT-VAL PERFORM FMT-I2
    MOVE SITE-CONTROL-TOTAL TO NREQ-INT-VAL PERFORM FMT-I3
    STRING "| Valid Sites (Impact / Control) | " FUNCTION TRIM(WS-N1)
           " (" FUNCTION TRIM(WS-N2) " / " FUNCTION TRIM(WS-N3) ") |"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    MOVE SURV-COUNT TO NREQ-INT-VAL PERFORM FMT-I1
    MOVE SURV-PRE-COUNT TO NREQ-INT-VAL PERFORM FMT-I2
    MOVE SURV-POST-COUNT TO NREQ-INT-VAL PERFORM FMT-I3
    MOVE SURV-TRANS-COUNT TO NREQ-INT-VAL PERFORM FMT-I4
    STRING "| Valid Surveys (PRE / POST / TRANSITION excluded) | "
           FUNCTION TRIM(WS-N1) " (" FUNCTION TRIM(WS-N2) " / "
           FUNCTION TRIM(WS-N3) " / " FUNCTION TRIM(WS-N4) ") |"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    MOVE OBS-COUNT TO NREQ-INT-VAL PERFORM FMT-I1
    MOVE OBS-DETECTED-COUNT TO NREQ-INT-VAL PERFORM FMT-I2
    MOVE OBS-NOT-DET-COUNT TO NREQ-INT-VAL PERFORM FMT-I3
    STRING "| Valid Observations (DETECTED / Explicit Zero NOT_DETECTED) | "
           FUNCTION TRIM(WS-N1) " (" FUNCTION TRIM(WS-N2) " / "
           FUNCTION TRIM(WS-N3) ") |"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    MOVE OBS-TRANS-EXCL-COUNT TO NREQ-INT-VAL PERFORM FMT-I1
    STRING "| Same-Day TRANSITION Observations Excluded | "
           FUNCTION TRIM(WS-N1) " |"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN

    *> Section 4: BACI Results
    MOVE "## 4. Before-After-Control-Impact (BACI) Results" TO WS-LINE PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN
    STRING "- **Method Policy:** `" FUNCTION TRIM(CFG-ACTIVE-METHOD)
           "` (incompatible observation methods are never silently pooled)"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    MOVE "- **Site Weighting:** Equal weighting of independent complete sites (`BACI = Impact Change - Control Change`)"
        TO WS-LINE PERFORM W-LN
    MOVE "- **Missingness Policy:** Absent species-survey rows are reported as missing and NEVER converted to zero."
        TO WS-LINE PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN

    MOVE "| Species | Method | Imp Sites | Ctrl Sites | Imp PRE | Imp POST | Ctrl PRE | Ctrl POST | Imp Chg | Ctrl Chg | BACI Est | Coverage % | Missing | 95% Site Bootstrap CI | LOSO Range |"
        TO WS-LINE PERFORM W-LN
    MOVE "|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---|---|"
        TO WS-LINE PERFORM W-LN

    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > BACI-COUNT
        MOVE BR-IMP-SITES(WS-I)  TO NREQ-INT-VAL PERFORM FMT-I1
        MOVE BR-CTRL-SITES(WS-I) TO NREQ-INT-VAL PERFORM FMT-I2
        IF BR-CALCULABLE(WS-I) = "Y"
            MOVE BR-IMP-PRE-MEAN(WS-I)   TO NREQ-DEC-VAL PERFORM FMT-D3
            MOVE BR-IMP-POST-MEAN(WS-I)  TO NREQ-DEC-VAL PERFORM FMT-D4
            MOVE BR-CTRL-PRE-MEAN(WS-I)  TO NREQ-DEC-VAL PERFORM FMT-D5
            MOVE BR-CTRL-POST-MEAN(WS-I) TO NREQ-DEC-VAL PERFORM FMT-D6
            MOVE BR-IMP-CHANGE(WS-I)     TO NREQ-DEC-VAL PERFORM FMT-D7
            MOVE BR-CTRL-CHANGE(WS-I)    TO NREQ-DEC-VAL PERFORM FMT-D8
            MOVE BR-BACI-EST(WS-I)       TO NREQ-DEC-VAL PERFORM FMT-D9
        ELSE
            MOVE "NA" TO WS-N3 WS-N4 WS-N5 WS-N6 WS-N7 WS-N8 WS-N9
        END-IF

        MOVE SPACES TO WS-CI-TXT
        IF FUNCTION TRIM(BR-CI-STATUS(WS-I)) = "REPORTED"
            INITIALIZE NUM-REQ
            MOVE "FMT-DEC6" TO NREQ-OP
            MOVE BR-CI-LOW(WS-I) TO NREQ-DEC-VAL
            CALL "NUMERIC-UTILS" USING NUM-REQ
            MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N1
            MOVE BR-CI-HIGH(WS-I) TO NREQ-DEC-VAL
            CALL "NUMERIC-UTILS" USING NUM-REQ
            MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N2
            STRING "[" FUNCTION TRIM(WS-N1) ", " FUNCTION TRIM(WS-N2) "]"
                   DELIMITED BY SIZE INTO WS-CI-TXT
            END-STRING
        ELSE
            STRING FUNCTION TRIM(BR-CI-STATUS(WS-I))
                   DELIMITED BY SIZE INTO WS-CI-TXT
            END-STRING
        END-IF

        MOVE SPACES TO WS-LOSO-TXT
        IF FUNCTION TRIM(BR-LOSO-STATUS(WS-I)) = "COMPUTED"
            INITIALIZE NUM-REQ
            MOVE "FMT-DEC6" TO NREQ-OP
            MOVE BR-LOSO-MIN(WS-I) TO NREQ-DEC-VAL
            CALL "NUMERIC-UTILS" USING NUM-REQ
            MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N1
            MOVE BR-LOSO-MAX(WS-I) TO NREQ-DEC-VAL
            CALL "NUMERIC-UTILS" USING NUM-REQ
            MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N2
            STRING "[" FUNCTION TRIM(WS-N1) ", " FUNCTION TRIM(WS-N2)
                   "] (infl: " FUNCTION TRIM(BR-LOSO-SITE(WS-I)) ")"
                   DELIMITED BY SIZE INTO WS-LOSO-TXT
            END-STRING
        ELSE
            MOVE "INSUFFICIENT" TO WS-LOSO-TXT
        END-IF

        MOVE BR-IMP-SITES(WS-I)  TO NREQ-INT-VAL PERFORM FMT-I1
        MOVE BR-CTRL-SITES(WS-I) TO NREQ-INT-VAL PERFORM FMT-I2

        INITIALIZE NUM-REQ
        MOVE "FMT-DEC2" TO NREQ-OP
        MOVE BR-COVERAGE-PCT(WS-I) TO NREQ-DEC-VAL
        CALL "NUMERIC-UTILS" USING NUM-REQ

        MOVE SPACES TO WS-LINE
        STRING "| `" FUNCTION TRIM(BR-SPECIES(WS-I)) "` | "
               FUNCTION TRIM(BR-METHOD(WS-I)) " | "
               FUNCTION TRIM(WS-N1) " | " FUNCTION TRIM(WS-N2) " | "
               FUNCTION TRIM(WS-N3) " | " FUNCTION TRIM(WS-N4) " | "
               FUNCTION TRIM(WS-N5) " | " FUNCTION TRIM(WS-N6) " | "
               FUNCTION TRIM(WS-N7) " | " FUNCTION TRIM(WS-N8) " | **"
               FUNCTION TRIM(WS-N9) "** | "
               FUNCTION TRIM(NREQ-TEXT-OUT) "% |"
               DELIMITED BY SIZE INTO WS-LINE
        END-STRING
        MOVE BR-OBS-MISSING(WS-I) TO NREQ-INT-VAL PERFORM FMT-I1
        STRING FUNCTION TRIM(WS-LINE) " " FUNCTION TRIM(WS-N1) " | "
               FUNCTION TRIM(WS-CI-TXT) " | "
               FUNCTION TRIM(WS-LOSO-TXT) " |"
               DELIMITED BY SIZE INTO WS-LINE
        END-STRING
        PERFORM W-LN
    END-PERFORM
    MOVE " " TO WS-LINE PERFORM W-LN

    *> Section 5: Site-Level Summaries
    MOVE "## 5. Site-Level Summaries" TO WS-LINE PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN
    MOVE "| Species | Method | Site | Role | PRE Obs/Surv | POST Obs/Surv | Zero Obs | Missing | PRE Mean | POST Mean | Site Change | Status |"
        TO WS-LINE PERFORM W-LN
    MOVE "|---|---|---|---|---:|---:|---:|---:|---:|---:|---:|---|"
        TO WS-LINE PERFORM W-LN

    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SSUM-COUNT OR WS-I > 200
        MOVE SS-PRE-OBS(WS-I)      TO NREQ-INT-VAL PERFORM FMT-I1
        MOVE SS-PRE-SURVEYS(WS-I)  TO NREQ-INT-VAL PERFORM FMT-I2
        MOVE SS-POST-OBS(WS-I)     TO NREQ-INT-VAL PERFORM FMT-I3
        MOVE SS-POST-SURVEYS(WS-I) TO NREQ-INT-VAL PERFORM FMT-I4
        MOVE SS-ZERO-OBS(WS-I)     TO NREQ-INT-VAL PERFORM FMT-I5
        MOVE SS-MISSING-OBS(WS-I)  TO NREQ-INT-VAL PERFORM FMT-I6
        IF SS-PRE-OBS(WS-I) > 0
            MOVE SS-PRE-MEAN(WS-I) TO NREQ-DEC-VAL PERFORM FMT-D7
        ELSE
            MOVE "NA" TO WS-N7
        END-IF
        IF SS-POST-OBS(WS-I) > 0
            MOVE SS-POST-MEAN(WS-I) TO NREQ-DEC-VAL PERFORM FMT-D8
        ELSE
            MOVE "NA" TO WS-N8
        END-IF
        IF FUNCTION TRIM(SS-STATUS(WS-I)) = "COMPLETE"
            MOVE SS-SITE-CHANGE(WS-I) TO NREQ-DEC-VAL PERFORM FMT-D9
        ELSE
            MOVE "NA" TO WS-N9
        END-IF
        STRING "| `" FUNCTION TRIM(SS-SPECIES(WS-I)) "` | "
               FUNCTION TRIM(SS-METHOD(WS-I)) " | `"
               FUNCTION TRIM(SS-SITE-ID(WS-I)) "` | "
               FUNCTION TRIM(SS-SITE-ROLE(WS-I)) " | "
               FUNCTION TRIM(WS-N1) "/" FUNCTION TRIM(WS-N2) " | "
               FUNCTION TRIM(WS-N3) "/" FUNCTION TRIM(WS-N4) " | "
               FUNCTION TRIM(WS-N5) " | " FUNCTION TRIM(WS-N6) " | "
               FUNCTION TRIM(WS-N7) " | " FUNCTION TRIM(WS-N8) " | "
               FUNCTION TRIM(WS-N9) " | `"
               FUNCTION TRIM(SS-STATUS(WS-I)) "` |"
               DELIMITED BY SIZE INTO WS-LINE
        END-STRING
        PERFORM W-LN
    END-PERFORM
    IF SSUM-COUNT > 200 OR SSUM-TRUNCATED = "Y"
        MOVE " " TO WS-LINE PERFORM W-LN
        MOVE "_Additional site rows are available in `site-summaries.csv`._"
            TO WS-LINE PERFORM W-LN
    END-IF
    MOVE " " TO WS-LINE PERFORM W-LN

    *> Section 6: Warnings
    MOVE "## 6. Analysis Warnings" TO WS-LINE PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN
    MOVE "N" TO WS-WARN-FOUND
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > ERR-COUNT
        IF ERR-SEVERITY(WS-I) = "WARNING"
            MOVE "Y" TO WS-WARN-FOUND
            STRING "- **`" FUNCTION TRIM(ERR-CODE(WS-I)) "`** ("
                   FUNCTION TRIM(ERR-FILE(WS-I)) "): "
                   FUNCTION TRIM(ERR-MESSAGE(WS-I))
                   DELIMITED BY SIZE INTO WS-LINE
            END-STRING
            PERFORM W-LN
        END-IF
    END-PERFORM
    IF WS-WARN-FOUND = "N"
        MOVE "- No analysis warnings were recorded." TO WS-LINE PERFORM W-LN
    END-IF
    MOVE " " TO WS-LINE PERFORM W-LN

    *> Section 7: Methodology & Precision
    MOVE "## 7. Transparent Calculation Methodology" TO WS-LINE PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN
    MOVE "1. **Effort Standardisation:** `Rate = Count * 60 / Survey_Minutes` (`detections_per_hour`), computed in COBOL fixed-point packed decimal (`COMP-3`, `S9(11)V9(6) ROUNDED`)."
        TO WS-LINE PERFORM W-LN
    MOVE "2. **Site-Period Aggregation:** For each `(species_code, method)` stratum and site, mean PRE and POST rates are averaged strictly over explicit observations (`DETECTED` and explicit `NOT_DETECTED` zero records). Missing rows are never imputed as zero."
        TO WS-LINE PERFORM W-LN
    MOVE "3. **Same-Day Intervention Exclusion:** Surveys occurring on `survey_date = reference_date` are classified as `TRANSITION` and excluded from primary PRE/POST means."
        TO WS-LINE PERFORM W-LN
    MOVE "4. **Equal-Site-Weighted BACI Estimator:** Each complete site contributes one `Site Change = POST mean - PRE mean`. Group changes are unweighted means across complete sites so survey frequency does not dominate the estimate: `BACI = Impact Change - Control Change`."
        TO WS-LINE PERFORM W-LN
    MOVE "5. **Site-Cluster Bootstrap Uncertainty:** Deterministic Park-Miller LCG (`a = 16807`, `m = 2147483647`) resampling complete independent sites with replacement. Nominal 95% percentile intervals (2.5th to 97.5th order-statistic interpolation) are reported ONLY when at least 5 complete independent sites exist in both Impact and Control groups. P-values are never manufactured."
        TO WS-LINE PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN

    *> Section 8: Scientific Limitations & Observation Model
    MOVE "## 8. Scientific Limitations" TO WS-LINE PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN
    MOVE "- **Observation Rates vs. True Abundance:** Version 1 (`EFFORT_RATE_V1`) quantifies effort-standardised detection rates. It does NOT estimate true ecological abundance and does NOT correct for imperfect species detection probability (reserved for the v2 repeated-visit occupancy/detection extension interface)."
        TO WS-LINE PERFORM W-LN
    MOVE "- **Causal Interpretation:** A BACI estimate is an observational difference-in-differences quantity, NOT proof of causation. Causal attribution requires defensible control-site comparability, parallel-trends assumptions, and absence of unmeasured differential confounding."
        TO WS-LINE PERFORM W-LN
    MOVE "- **Small-Sample Uncertainty:** With fewer than 5 complete independent sites per group, inferential confidence intervals are intentionally withheld rather than manufactured."
        TO WS-LINE PERFORM W-LN
    MOVE "- **Study-Design Bias:** Neither bootstrap intervals nor sensitivity ranges remove bias introduced by unrepresentative sites or non-comparable survey protocols."
        TO WS-LINE PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN

    *> Section 9: Reproducibility
    MOVE "## 9. Reproducibility Reference" TO WS-LINE PERFORM W-LN
    MOVE " " TO WS-LINE PERFORM W-LN
    MOVE CFG-SEED TO NREQ-INT-VAL PERFORM FMT-I1
    MOVE CFG-BOOTSTRAP TO NREQ-INT-VAL PERFORM FMT-I2
    STRING "- **Software:** FIELDLEDGER v" FL-APP-VERSION
           " compiled with " FL-COMPILER-LABEL
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    STRING "- **Bootstrap Configuration:** seed = `" FUNCTION TRIM(WS-N1)
           "`, iterations = `" FUNCTION TRIM(WS-N2) "`"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM W-LN
    MOVE "- **Research Receipt:** `research-receipt.json`" TO WS-LINE PERFORM W-LN
    MOVE "- **Append-Only Run Ledger:** `evidence-ledger.csv`" TO WS-LINE PERFORM W-LN

    CLOSE F-MD
    IF WS-WRITE-OK = "N"
        MOVE FL-EXIT-IO-ERR TO L-MD-RC
    END-IF
    GOBACK.

FMT-I1. MOVE "FMT-INT" TO NREQ-OP CALL "NUMERIC-UTILS" USING NUM-REQ MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N1.
FMT-I2. MOVE "FMT-INT" TO NREQ-OP CALL "NUMERIC-UTILS" USING NUM-REQ MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N2.
FMT-I3. MOVE "FMT-INT" TO NREQ-OP CALL "NUMERIC-UTILS" USING NUM-REQ MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N3.
FMT-I4. MOVE "FMT-INT" TO NREQ-OP CALL "NUMERIC-UTILS" USING NUM-REQ MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N4.
FMT-I5. MOVE "FMT-INT" TO NREQ-OP CALL "NUMERIC-UTILS" USING NUM-REQ MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N5.
FMT-I6. MOVE "FMT-INT" TO NREQ-OP CALL "NUMERIC-UTILS" USING NUM-REQ MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N6.
FMT-D3. MOVE "FMT-DEC6" TO NREQ-OP CALL "NUMERIC-UTILS" USING NUM-REQ MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N3.
FMT-D4. MOVE "FMT-DEC6" TO NREQ-OP CALL "NUMERIC-UTILS" USING NUM-REQ MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N4.
FMT-D5. MOVE "FMT-DEC6" TO NREQ-OP CALL "NUMERIC-UTILS" USING NUM-REQ MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N5.
FMT-D6. MOVE "FMT-DEC6" TO NREQ-OP CALL "NUMERIC-UTILS" USING NUM-REQ MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N6.
FMT-D7. MOVE "FMT-DEC6" TO NREQ-OP CALL "NUMERIC-UTILS" USING NUM-REQ MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N7.
FMT-D8. MOVE "FMT-DEC6" TO NREQ-OP CALL "NUMERIC-UTILS" USING NUM-REQ MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N8.
FMT-D9. MOVE "FMT-DEC6" TO NREQ-OP CALL "NUMERIC-UTILS" USING NUM-REQ MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-N9.

W-LN.
    IF WS-WRITE-OK = "N"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-LINE TO F-MD-REC
    WRITE F-MD-REC
    IF WS-FS NOT = "00"
        PERFORM MARK-FAIL
    END-IF
    MOVE SPACES TO WS-LINE
    .

MARK-FAIL.
    MOVE "N" TO WS-WRITE-OK
    STRING "Failed writing report.md (status " WS-FS ")"
           DELIMITED BY SIZE INTO CFG-ERROR-MSG
    END-STRING
    .
