>>SOURCE FORMAT FREE
*> =====================================================================
*> FIELDLEDGER - CSV-REPORTER.cob
*> Writes RFC 4180 CSV outputs with full I/O error checking:
*>   - validation-report.csv
*>   - data-quality.csv
*>   - baci-results.csv
*>   - site-summaries.csv
*> =====================================================================
IDENTIFICATION DIVISION.
PROGRAM-ID. CSV-REPORTER.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT F-CSV ASSIGN TO DYNAMIC WS-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS.

DATA DIVISION.
FILE SECTION.
FD F-CSV.
01 F-CSV-REC                PIC X(2048).

WORKING-STORAGE SECTION.
COPY "LIMITS.cpy".
COPY "RUN-CONFIG.cpy".
COPY "STUDY-RECORD.cpy".
COPY "SOURCE-RECORD.cpy".
COPY "SITE-RECORD.cpy".
COPY "SURVEY-RECORD.cpy".
COPY "OBSERVATION-RECORD.cpy".
COPY "ERROR-RECORD.cpy".
COPY "BACI-RESULT.cpy".
COPY "UTILS-IFACE.cpy".

01 WS-FILE-PATH             PIC X(512).
01 WS-FS                    PIC XX.
01 WS-LINE                  PIC X(2048).
01 WS-POS                   PIC 9(6) COMP-5.
01 WS-I                     PIC 9(9) COMP-5.
01 WS-WRITE-OK              PIC X(1).
01 WS-CSV-TMP               PIC X(512).
01 WS-METRIC-NAME           PIC X(64).
01 WS-METRIC-CAT            PIC X(32).
01 WS-METRIC-VAL            PIC X(64).
01 WS-METRIC-NOTE           PIC X(160).
01 WS-TOT-MISSING           PIC 9(9) COMP-5.
01 WS-TOT-ELIG              PIC 9(9) COMP-5.
01 WS-TOT-EXP               PIC 9(9) COMP-5.
01 WS-OVERALL-COV           PIC S9(5)V9(2) COMP-3.
01 WS-TOT-REJ               PIC 9(9) COMP-5.
01 WS-TOT-DUPS              PIC 9(9) COMP-5.

LINKAGE SECTION.
01 L-CSV-OP                 PIC X(24).
01 L-CSV-RC                 PIC S9(4) COMP-5.

PROCEDURE DIVISION USING L-CSV-OP L-CSV-RC.
MAIN-CSV-REP.
    MOVE FL-EXIT-OK TO L-CSV-RC
    MOVE "Y" TO WS-WRITE-OK

    INITIALIZE CFG-REQ
    MOVE "ENSURE-DIR" TO CREQ-OP
    MOVE CFG-OUT-PATH TO CREQ-PATH-A
    CALL "CONFIGURATION" USING CFG-REQ

    EVALUATE FUNCTION TRIM(L-CSV-OP)
        WHEN "WRITE-VALIDATION"
            PERFORM WRITE-VALIDATION-CSV
            IF WS-WRITE-OK = "Y"
                PERFORM WRITE-QUALITY-CSV
            END-IF

        WHEN "WRITE-BACI"
            PERFORM WRITE-BACI-CSV
            IF WS-WRITE-OK = "Y"
                PERFORM WRITE-SITE-SUM-CSV
            END-IF

        WHEN OTHER
            MOVE FL-EXIT-CLI-ERR TO L-CSV-RC
            GOBACK
    END-EVALUATE

    IF WS-WRITE-OK = "N"
        MOVE FL-EXIT-IO-ERR TO L-CSV-RC
    END-IF
    GOBACK.

WRITE-VALIDATION-CSV.
    INITIALIZE CFG-REQ
    MOVE "JOIN-PATH"             TO CREQ-OP
    MOVE CFG-OUT-PATH            TO CREQ-PATH-A
    MOVE "validation-report.csv" TO CREQ-PATH-B
    CALL "CONFIGURATION" USING CFG-REQ
    MOVE CREQ-PATH-OUT TO WS-FILE-PATH

    OPEN OUTPUT F-CSV
    IF WS-FS NOT = "00"
        PERFORM MARK-IO-FAIL
        EXIT PARAGRAPH
    END-IF

    MOVE "severity,code,file,row,field,message" TO WS-LINE
    PERFORM WRITE-LINE

    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > ERR-COUNT OR WS-WRITE-OK = "N"
        MOVE SPACES TO WS-LINE
        MOVE 1 TO WS-POS
        MOVE ERR-SEVERITY(WS-I) TO WS-CSV-TMP PERFORM APP-FIRST
        MOVE ERR-CODE(WS-I)     TO WS-CSV-TMP PERFORM APP-NEXT
        MOVE ERR-FILE(WS-I)     TO WS-CSV-TMP PERFORM APP-NEXT
        MOVE ERR-ROW(WS-I)      TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE ERR-FIELD(WS-I)    TO WS-CSV-TMP PERFORM APP-NEXT
        MOVE ERR-MESSAGE(WS-I)  TO WS-CSV-TMP PERFORM APP-NEXT
        PERFORM WRITE-LINE
    END-PERFORM

    CLOSE F-CSV
    .

WRITE-QUALITY-CSV.
    INITIALIZE CFG-REQ
    MOVE "JOIN-PATH"        TO CREQ-OP
    MOVE CFG-OUT-PATH       TO CREQ-PATH-A
    MOVE "data-quality.csv" TO CREQ-PATH-B
    CALL "CONFIGURATION" USING CFG-REQ
    MOVE CREQ-PATH-OUT TO WS-FILE-PATH

    OPEN OUTPUT F-CSV
    IF WS-FS NOT = "00"
        PERFORM MARK-IO-FAIL
        EXIT PARAGRAPH
    END-IF

    MOVE "metric,category,value,notes" TO WS-LINE
    PERFORM WRITE-LINE

    COMPUTE WS-TOT-REJ = STUDY-REJECTED-ROWS + SRC-REJECTED-ROWS
                       + SITE-REJECTED-ROWS  + SURV-REJECTED-ROWS
                       + OBS-REJECTED-ROWS
    COMPUTE WS-TOT-DUPS = SRC-DUP-COUNT + SITE-DUP-COUNT + SURV-DUP-COUNT
                        + OBS-DUP-ID-COUNT + OBS-DUP-KEY-COUNT

    MOVE "study_id" TO WS-METRIC-NAME
    MOVE "identity" TO WS-METRIC-CAT
    IF FUNCTION TRIM(ST-STUDY-ID) = SPACES
        MOVE "UNKNOWN" TO WS-METRIC-VAL
    ELSE
        MOVE ST-STUDY-ID TO WS-METRIC-VAL
    END-IF
    MOVE "Study identifier from study.csv" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "validation_errors" TO WS-METRIC-NAME
    MOVE "validation" TO WS-METRIC-CAT
    MOVE ERR-ERROR-CNT TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Total blocking validation errors" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "validation_warnings" TO WS-METRIC-NAME
    MOVE "validation" TO WS-METRIC-CAT
    MOVE ERR-WARN-CNT TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Total non-blocking validation and statistical warnings" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "sources_valid" TO WS-METRIC-NAME
    MOVE "counts" TO WS-METRIC-CAT
    MOVE SRC-COUNT TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Valid provenance source records" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "sites_valid" TO WS-METRIC-NAME
    MOVE "counts" TO WS-METRIC-CAT
    MOVE SITE-COUNT TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Valid study sites (IMPACT + CONTROL)" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "sites_impact" TO WS-METRIC-NAME
    MOVE "counts" TO WS-METRIC-CAT
    MOVE SITE-IMPACT-TOTAL TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Sites with site_role = IMPACT" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "sites_control" TO WS-METRIC-NAME
    MOVE "counts" TO WS-METRIC-CAT
    MOVE SITE-CONTROL-TOTAL TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Sites with site_role = CONTROL" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "surveys_valid" TO WS-METRIC-NAME
    MOVE "counts" TO WS-METRIC-CAT
    MOVE SURV-COUNT TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Valid survey records" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "surveys_pre" TO WS-METRIC-NAME
    MOVE "temporal" TO WS-METRIC-CAT
    MOVE SURV-PRE-COUNT TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Surveys strictly before site reference_date" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "surveys_post" TO WS-METRIC-NAME
    MOVE "temporal" TO WS-METRIC-CAT
    MOVE SURV-POST-COUNT TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Surveys strictly after site reference_date" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "surveys_transition_excluded" TO WS-METRIC-NAME
    MOVE "exclusions" TO WS-METRIC-CAT
    MOVE SURV-TRANS-COUNT TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Same-day intervention surveys excluded from primary BACI" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "observations_valid" TO WS-METRIC-NAME
    MOVE "counts" TO WS-METRIC-CAT
    MOVE OBS-COUNT TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Valid observation records" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "observations_detected" TO WS-METRIC-NAME
    MOVE "observations" TO WS-METRIC-CAT
    MOVE OBS-DETECTED-COUNT TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Explicit DETECTED records (count > 0)" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "observations_explicit_zero" TO WS-METRIC-NAME
    MOVE "observations" TO WS-METRIC-CAT
    MOVE OBS-NOT-DET-COUNT TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Explicit NOT_DETECTED records (count = 0)" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "observations_transition_excluded" TO WS-METRIC-NAME
    MOVE "exclusions" TO WS-METRIC-CAT
    MOVE OBS-TRANS-EXCL-COUNT TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Observations on site reference_date excluded from primary BACI" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "records_rejected_total" TO WS-METRIC-NAME
    MOVE "validation" TO WS-METRIC-CAT
    MOVE WS-TOT-REJ TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Total malformed or invalid rows rejected across all files" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "duplicate_records_total" TO WS-METRIC-NAME
    MOVE "duplicates" TO WS-METRIC-CAT
    MOVE WS-TOT-DUPS TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Total duplicate IDs and duplicate (survey_id, species_code) keys" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "distinct_methods" TO WS-METRIC-NAME
    MOVE "methods" TO WS-METRIC-CAT
    MOVE SURV-METHOD-COUNT TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Distinct observation methods in surveys.csv (never silently pooled)" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    *> Aggregate missingness & coverage across analyzed strata (if BACI ran)
    MOVE 0 TO WS-TOT-MISSING
    MOVE 0 TO WS-TOT-ELIG
    MOVE 0 TO WS-TOT-EXP
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > BACI-COUNT
        ADD BR-OBS-MISSING(WS-I)      TO WS-TOT-MISSING
        ADD BR-SURVEYS-ELIGIBLE(WS-I) TO WS-TOT-ELIG
        ADD BR-OBS-USED(WS-I)         TO WS-TOT-EXP
    END-PERFORM

    MOVE "missing_species_survey_cells" TO WS-METRIC-NAME
    MOVE "missingness" TO WS-METRIC-CAT
    MOVE WS-TOT-MISSING TO NREQ-INT-VAL PERFORM FMT-INT-TO-VAL
    MOVE "Absent species-survey records across analyzed strata (NEVER converted to zero)"
        TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    IF WS-TOT-ELIG > 0
        COMPUTE WS-OVERALL-COV ROUNDED = (WS-TOT-EXP * 100) / WS-TOT-ELIG
    ELSE
        MOVE 0 TO WS-OVERALL-COV
    END-IF
    MOVE "overall_species_coverage_pct" TO WS-METRIC-NAME
    MOVE "missingness" TO WS-METRIC-CAT
    INITIALIZE NUM-REQ
    MOVE "FMT-DEC2" TO NREQ-OP
    MOVE WS-OVERALL-COV TO NREQ-DEC-VAL
    CALL "NUMERIC-UTILS" USING NUM-REQ
    MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-METRIC-VAL
    MOVE "Percentage of eligible site-surveys with explicit species records"
        TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    MOVE "manifest_status" TO WS-METRIC-NAME
    MOVE "provenance" TO WS-METRIC-CAT
    MOVE CFG-MANIFEST-STATUS TO WS-METRIC-VAL
    MOVE "SHA-256 input manifest detection status" TO WS-METRIC-NOTE
    PERFORM WRITE-DQ-ROW

    CLOSE F-CSV
    .

WRITE-DQ-ROW.
    IF WS-WRITE-OK = "N"
        EXIT PARAGRAPH
    END-IF
    MOVE SPACES TO WS-LINE
    MOVE 1 TO WS-POS
    MOVE WS-METRIC-NAME TO WS-CSV-TMP PERFORM APP-FIRST
    MOVE WS-METRIC-CAT  TO WS-CSV-TMP PERFORM APP-NEXT
    MOVE WS-METRIC-VAL  TO WS-CSV-TMP PERFORM APP-NEXT
    MOVE WS-METRIC-NOTE TO WS-CSV-TMP PERFORM APP-NEXT
    PERFORM WRITE-LINE
    .

FMT-INT-TO-VAL.
    MOVE "FMT-INT" TO NREQ-OP
    CALL "NUMERIC-UTILS" USING NUM-REQ
    MOVE FUNCTION TRIM(NREQ-TEXT-OUT) TO WS-METRIC-VAL
    .

WRITE-BACI-CSV.
    INITIALIZE CFG-REQ
    MOVE "JOIN-PATH"        TO CREQ-OP
    MOVE CFG-OUT-PATH       TO CREQ-PATH-A
    MOVE "baci-results.csv" TO CREQ-PATH-B
    CALL "CONFIGURATION" USING CFG-REQ
    MOVE CREQ-PATH-OUT TO WS-FILE-PATH

    OPEN OUTPUT F-CSV
    IF WS-FS NOT = "00"
        PERFORM MARK-IO-FAIL
        EXIT PARAGRAPH
    END-IF

    MOVE SPACES TO WS-LINE
    STRING "species_code,method,unit,calculable,impact_sites,control_sites,"
           "excluded_impact_sites,excluded_control_sites,"
           "impact_pre_mean,impact_post_mean,control_pre_mean,control_post_mean,"
           "impact_change,control_change,baci_estimate,"
           "surveys_used,surveys_eligible,observations_used,"
           "explicit_zero_observations,missing_observations,"
           "transition_excluded_observations,coverage_pct,"
           "bootstrap_seed,bootstrap_iterations,bootstrap_replicates,"
           "ci_status,ci_95_low,ci_95_high,"
           "loso_status,loso_min_baci,loso_max_baci,"
           "loso_most_influential_site,warnings"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM WRITE-LINE

    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > BACI-COUNT OR WS-WRITE-OK = "N"
        MOVE SPACES TO WS-LINE
        MOVE 1 TO WS-POS
        MOVE BR-SPECIES(WS-I)    TO WS-CSV-TMP PERFORM APP-FIRST
        MOVE BR-METHOD(WS-I)     TO WS-CSV-TMP PERFORM APP-NEXT
        MOVE BR-UNIT(WS-I)       TO WS-CSV-TMP PERFORM APP-NEXT
        MOVE BR-CALCULABLE(WS-I) TO WS-CSV-TMP PERFORM APP-NEXT
        MOVE BR-IMP-SITES(WS-I)       TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE BR-CTRL-SITES(WS-I)      TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE BR-EXCL-IMP-SITES(WS-I)  TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE BR-EXCL-CTRL-SITES(WS-I) TO NREQ-INT-VAL PERFORM APP-INT-NEXT

        IF BR-CALCULABLE(WS-I) = "Y"
            MOVE BR-IMP-PRE-MEAN(WS-I)   TO NREQ-DEC-VAL PERFORM APP-DEC6-NEXT
            MOVE BR-IMP-POST-MEAN(WS-I)  TO NREQ-DEC-VAL PERFORM APP-DEC6-NEXT
            MOVE BR-CTRL-PRE-MEAN(WS-I)  TO NREQ-DEC-VAL PERFORM APP-DEC6-NEXT
            MOVE BR-CTRL-POST-MEAN(WS-I) TO NREQ-DEC-VAL PERFORM APP-DEC6-NEXT
            MOVE BR-IMP-CHANGE(WS-I)     TO NREQ-DEC-VAL PERFORM APP-DEC6-NEXT
            MOVE BR-CTRL-CHANGE(WS-I)    TO NREQ-DEC-VAL PERFORM APP-DEC6-NEXT
            MOVE BR-BACI-EST(WS-I)       TO NREQ-DEC-VAL PERFORM APP-DEC6-NEXT
        ELSE
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
        END-IF

        MOVE BR-SURVEYS-USED(WS-I)      TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE BR-SURVEYS-ELIGIBLE(WS-I)  TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE BR-OBS-USED(WS-I)          TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE BR-OBS-EXPLICIT-ZERO(WS-I) TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE BR-OBS-MISSING(WS-I)       TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE BR-OBS-TRANS-EXCL(WS-I)    TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE BR-COVERAGE-PCT(WS-I)      TO NREQ-DEC-VAL PERFORM APP-DEC2-NEXT

        MOVE BR-BOOT-SEED(WS-I)  TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE BR-BOOT-ITERS(WS-I) TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE BR-BOOT-REPS(WS-I)  TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE BR-CI-STATUS(WS-I)  TO WS-CSV-TMP   PERFORM APP-NEXT

        IF FUNCTION TRIM(BR-CI-STATUS(WS-I)) = "REPORTED"
            MOVE BR-CI-LOW(WS-I)  TO NREQ-DEC-VAL PERFORM APP-DEC6-NEXT
            MOVE BR-CI-HIGH(WS-I) TO NREQ-DEC-VAL PERFORM APP-DEC6-NEXT
        ELSE
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
        END-IF

        MOVE BR-LOSO-STATUS(WS-I) TO WS-CSV-TMP PERFORM APP-NEXT
        IF FUNCTION TRIM(BR-LOSO-STATUS(WS-I)) = "COMPUTED"
            MOVE BR-LOSO-MIN(WS-I)  TO NREQ-DEC-VAL PERFORM APP-DEC6-NEXT
            MOVE BR-LOSO-MAX(WS-I)  TO NREQ-DEC-VAL PERFORM APP-DEC6-NEXT
            MOVE BR-LOSO-SITE(WS-I) TO WS-CSV-TMP   PERFORM APP-NEXT
        ELSE
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
        END-IF

        MOVE BR-WARNINGS(WS-I) TO WS-CSV-TMP PERFORM APP-NEXT
        PERFORM WRITE-LINE
    END-PERFORM

    CLOSE F-CSV
    .

WRITE-SITE-SUM-CSV.
    INITIALIZE CFG-REQ
    MOVE "JOIN-PATH"          TO CREQ-OP
    MOVE CFG-OUT-PATH         TO CREQ-PATH-A
    MOVE "site-summaries.csv" TO CREQ-PATH-B
    CALL "CONFIGURATION" USING CFG-REQ
    MOVE CREQ-PATH-OUT TO WS-FILE-PATH

    OPEN OUTPUT F-CSV
    IF WS-FS NOT = "00"
        PERFORM MARK-IO-FAIL
        EXIT PARAGRAPH
    END-IF

    MOVE SPACES TO WS-LINE
    STRING "species_code,method,site_id,site_role,pre_surveys,post_surveys,"
           "transition_surveys,pre_observations,post_observations,"
           "transition_observations,explicit_zero_observations,"
           "missing_observations,pre_mean,post_mean,site_change,"
           "coverage_pct,status"
           DELIMITED BY SIZE INTO WS-LINE
    END-STRING
    PERFORM WRITE-LINE

    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SSUM-COUNT OR WS-WRITE-OK = "N"
        MOVE SPACES TO WS-LINE
        MOVE 1 TO WS-POS
        MOVE SS-SPECIES(WS-I)       TO WS-CSV-TMP   PERFORM APP-FIRST
        MOVE SS-METHOD(WS-I)        TO WS-CSV-TMP   PERFORM APP-NEXT
        MOVE SS-SITE-ID(WS-I)       TO WS-CSV-TMP   PERFORM APP-NEXT
        MOVE SS-SITE-ROLE(WS-I)     TO WS-CSV-TMP   PERFORM APP-NEXT
        MOVE SS-PRE-SURVEYS(WS-I)   TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE SS-POST-SURVEYS(WS-I)  TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE SS-TRANS-SURVEYS(WS-I) TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE SS-PRE-OBS(WS-I)       TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE SS-POST-OBS(WS-I)      TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE SS-TRANS-OBS(WS-I)     TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE SS-ZERO-OBS(WS-I)      TO NREQ-INT-VAL PERFORM APP-INT-NEXT
        MOVE SS-MISSING-OBS(WS-I)   TO NREQ-INT-VAL PERFORM APP-INT-NEXT

        IF SS-PRE-OBS(WS-I) > 0
            MOVE SS-PRE-MEAN(WS-I) TO NREQ-DEC-VAL PERFORM APP-DEC6-NEXT
        ELSE
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
        END-IF
        IF SS-POST-OBS(WS-I) > 0
            MOVE SS-POST-MEAN(WS-I) TO NREQ-DEC-VAL PERFORM APP-DEC6-NEXT
        ELSE
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
        END-IF
        IF FUNCTION TRIM(SS-STATUS(WS-I)) = "COMPLETE"
            MOVE SS-SITE-CHANGE(WS-I) TO NREQ-DEC-VAL PERFORM APP-DEC6-NEXT
        ELSE
            MOVE "NA" TO WS-CSV-TMP PERFORM APP-NEXT
        END-IF

        MOVE SS-COVERAGE-PCT(WS-I) TO NREQ-DEC-VAL PERFORM APP-DEC2-NEXT
        MOVE SS-STATUS(WS-I)       TO WS-CSV-TMP   PERFORM APP-NEXT
        PERFORM WRITE-LINE
    END-PERFORM

    CLOSE F-CSV
    .

APP-FIRST.
    INITIALIZE NUM-REQ
    MOVE "ESC-CSV"  TO NREQ-OP
    MOVE WS-CSV-TMP TO NREQ-TEXT-IN
    CALL "NUMERIC-UTILS" USING NUM-REQ
    IF NREQ-OUT-LEN > 0
        MOVE NREQ-TEXT-OUT(1:NREQ-OUT-LEN) TO WS-LINE(WS-POS:NREQ-OUT-LEN)
        ADD NREQ-OUT-LEN TO WS-POS
    END-IF
    .

APP-NEXT.
    MOVE "," TO WS-LINE(WS-POS:1)
    ADD 1 TO WS-POS
    INITIALIZE NUM-REQ
    MOVE "ESC-CSV"  TO NREQ-OP
    MOVE WS-CSV-TMP TO NREQ-TEXT-IN
    CALL "NUMERIC-UTILS" USING NUM-REQ
    IF NREQ-OUT-LEN > 0 AND (WS-POS + NREQ-OUT-LEN) <= 2048
        MOVE NREQ-TEXT-OUT(1:NREQ-OUT-LEN) TO WS-LINE(WS-POS:NREQ-OUT-LEN)
        ADD NREQ-OUT-LEN TO WS-POS
    END-IF
    .

APP-INT-NEXT.
    MOVE "," TO WS-LINE(WS-POS:1)
    ADD 1 TO WS-POS
    MOVE "FMT-INT" TO NREQ-OP
    CALL "NUMERIC-UTILS" USING NUM-REQ
    IF NREQ-OUT-LEN > 0 AND (WS-POS + NREQ-OUT-LEN) <= 2048
        MOVE NREQ-TEXT-OUT(1:NREQ-OUT-LEN) TO WS-LINE(WS-POS:NREQ-OUT-LEN)
        ADD NREQ-OUT-LEN TO WS-POS
    END-IF
    .

APP-DEC6-NEXT.
    MOVE "," TO WS-LINE(WS-POS:1)
    ADD 1 TO WS-POS
    MOVE "FMT-DEC6" TO NREQ-OP
    CALL "NUMERIC-UTILS" USING NUM-REQ
    IF NREQ-OUT-LEN > 0 AND (WS-POS + NREQ-OUT-LEN) <= 2048
        MOVE NREQ-TEXT-OUT(1:NREQ-OUT-LEN) TO WS-LINE(WS-POS:NREQ-OUT-LEN)
        ADD NREQ-OUT-LEN TO WS-POS
    END-IF
    .

APP-DEC2-NEXT.
    MOVE "," TO WS-LINE(WS-POS:1)
    ADD 1 TO WS-POS
    MOVE "FMT-DEC2" TO NREQ-OP
    CALL "NUMERIC-UTILS" USING NUM-REQ
    IF NREQ-OUT-LEN > 0 AND (WS-POS + NREQ-OUT-LEN) <= 2048
        MOVE NREQ-TEXT-OUT(1:NREQ-OUT-LEN) TO WS-LINE(WS-POS:NREQ-OUT-LEN)
        ADD NREQ-OUT-LEN TO WS-POS
    END-IF
    .

WRITE-LINE.
    IF WS-WRITE-OK = "N"
        EXIT PARAGRAPH
    END-IF
    MOVE WS-LINE TO F-CSV-REC
    WRITE F-CSV-REC
    IF WS-FS NOT = "00"
        PERFORM MARK-IO-FAIL
    END-IF
    MOVE SPACES TO WS-LINE
    .

MARK-IO-FAIL.
    MOVE "N" TO WS-WRITE-OK
    STRING "Failed writing CSV output '" FUNCTION TRIM(WS-FILE-PATH)
           "' (file status " WS-FS ")"
           DELIMITED BY SIZE INTO CFG-ERROR-MSG
    END-STRING
    .
