>>SOURCE FORMAT FREE
*> =====================================================================
*> FIELDLEDGER - BACI-ENGINE.cob
*> Equal-site-weighted Before-After-Control-Impact (BACI) engine:
*>   BACI = Mean(Impact Site Changes) - Mean(Control Site Changes)
*> Orchestrates effort standardisation, species aggregation, site
*> summaries, BACI calculation, bootstrap uncertainty, and LOSO sensitivity.
*> =====================================================================
IDENTIFICATION DIVISION.
PROGRAM-ID. BACI-ENGINE.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "LIMITS.cpy".
COPY "RUN-CONFIG.cpy".
COPY "BACI-RESULT.cpy".
COPY "ANALYSIS-WORK.cpy".
COPY "UTILS-IFACE.cpy".

01 WS-K                     PIC 9(6) COMP-5.
01 WS-I                     PIC 9(6) COMP-5.
01 WS-AGG-RC                PIC S9(4) COMP-5.
01 WS-SUM-IMP-PRE           PIC S9(15)V9(6) COMP-3.
01 WS-SUM-IMP-POST          PIC S9(15)V9(6) COMP-3.
01 WS-SUM-IMP-CHG           PIC S9(15)V9(6) COMP-3.
01 WS-SUM-CTRL-PRE          PIC S9(15)V9(6) COMP-3.
01 WS-SUM-CTRL-POST         PIC S9(15)V9(6) COMP-3.
01 WS-SUM-CTRL-CHG          PIC S9(15)V9(6) COMP-3.
01 WS-WARN-TMP              PIC X(256).

LINKAGE SECTION.
01 L-BACI-RC                PIC S9(4) COMP-5.

PROCEDURE DIVISION USING L-BACI-RC.
MAIN-BACI.
    MOVE FL-EXIT-OK TO L-BACI-RC
    MOVE "BACI" TO CFG-ANALYSIS-TYPE
    MOVE 0 TO SSUM-COUNT
    MOVE "N" TO SSUM-TRUNCATED

    *> Step 1: Effort standardisation
    CALL "EFFORT-STANDARDISER"

    *> Step 2: Species/method stratification and slice indexing
    MOVE 0 TO WS-AGG-RC
    CALL "SPECIES-AGGREGATOR" USING WS-AGG-RC
    IF WS-AGG-RC NOT = FL-EXIT-OK
        MOVE WS-AGG-RC TO L-BACI-RC
        GOBACK
    END-IF

    *> Step 3..6: Per-stratum site summaries, BACI, uncertainty, sensitivity
    PERFORM VARYING WS-K FROM 1 BY 1 UNTIL WS-K > BACI-COUNT
        MOVE WS-K TO SW-STRATUM-IDX
        CALL "SITE-SUMMARY"

        IF BACI-MULTI-METHOD-FLAG = "Y"
            MOVE "MULTI_METHOD_STRATIFIED" TO BR-WARNINGS(WS-K)
        END-IF

        IF BR-OBS-MISSING(WS-K) > 0
            PERFORM APPEND-WARN-MISSING
        END-IF
        IF BR-OBS-TRANS-EXCL(WS-K) > 0
            PERFORM APPEND-WARN-TRANS
        END-IF

        IF SW-IMP-CNT > 0 AND SW-CTRL-CNT > 0
            MOVE 0 TO WS-SUM-IMP-PRE
            MOVE 0 TO WS-SUM-IMP-POST
            MOVE 0 TO WS-SUM-IMP-CHG
            PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SW-IMP-CNT
                ADD SWI-PRE-MEAN(WS-I)  TO WS-SUM-IMP-PRE
                ADD SWI-POST-MEAN(WS-I) TO WS-SUM-IMP-POST
                ADD SWI-CHANGE(WS-I)    TO WS-SUM-IMP-CHG
            END-PERFORM

            MOVE 0 TO WS-SUM-CTRL-PRE
            MOVE 0 TO WS-SUM-CTRL-POST
            MOVE 0 TO WS-SUM-CTRL-CHG
            PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > SW-CTRL-CNT
                ADD SWC-PRE-MEAN(WS-I)  TO WS-SUM-CTRL-PRE
                ADD SWC-POST-MEAN(WS-I) TO WS-SUM-CTRL-POST
                ADD SWC-CHANGE(WS-I)    TO WS-SUM-CTRL-CHG
            END-PERFORM

            COMPUTE BR-IMP-PRE-MEAN(WS-K)  ROUNDED = WS-SUM-IMP-PRE / SW-IMP-CNT
            COMPUTE BR-IMP-POST-MEAN(WS-K) ROUNDED = WS-SUM-IMP-POST / SW-IMP-CNT
            COMPUTE BR-IMP-CHANGE(WS-K)    ROUNDED = WS-SUM-IMP-CHG / SW-IMP-CNT

            COMPUTE BR-CTRL-PRE-MEAN(WS-K)  ROUNDED = WS-SUM-CTRL-PRE / SW-CTRL-CNT
            COMPUTE BR-CTRL-POST-MEAN(WS-K) ROUNDED = WS-SUM-CTRL-POST / SW-CTRL-CNT
            COMPUTE BR-CTRL-CHANGE(WS-K)    ROUNDED = WS-SUM-CTRL-CHG / SW-CTRL-CNT

            COMPUTE BR-BACI-EST(WS-K) =
                BR-IMP-CHANGE(WS-K) - BR-CTRL-CHANGE(WS-K)
            MOVE "Y" TO BR-CALCULABLE(WS-K)

            CALL "UNCERTAINTY-ENGINE"
            CALL "SENSITIVITY-ENGINE"
        ELSE
            MOVE "N" TO BR-CALCULABLE(WS-K)
            MOVE "NOT_CALCULABLE" TO BR-CI-STATUS(WS-K)
            MOVE "INSUFFICIENT"   TO BR-LOSO-STATUS(WS-K)
            MOVE "NA"             TO BR-LOSO-SITE(WS-K)
            IF SW-IMP-CNT = 0
                PERFORM APPEND-WARN-NO-IMP
            END-IF
            IF SW-CTRL-CNT = 0
                PERFORM APPEND-WARN-NO-CTRL
            END-IF
        END-IF
    END-PERFORM
    GOBACK.

APPEND-WARN-MISSING.
    MOVE SPACES TO WS-WARN-TMP
    IF FUNCTION TRIM(BR-WARNINGS(WS-K)) = SPACES
        MOVE "MISSING_OBSERVATIONS_PRESENT" TO BR-WARNINGS(WS-K)
    ELSE
        STRING FUNCTION TRIM(BR-WARNINGS(WS-K)) ";MISSING_OBSERVATIONS_PRESENT"
               DELIMITED BY SIZE INTO WS-WARN-TMP
        END-STRING
        MOVE WS-WARN-TMP TO BR-WARNINGS(WS-K)
    END-IF
    .

APPEND-WARN-TRANS.
    MOVE SPACES TO WS-WARN-TMP
    IF FUNCTION TRIM(BR-WARNINGS(WS-K)) = SPACES
        MOVE "TRANSITION_OBS_EXCLUDED" TO BR-WARNINGS(WS-K)
    ELSE
        STRING FUNCTION TRIM(BR-WARNINGS(WS-K)) ";TRANSITION_OBS_EXCLUDED"
               DELIMITED BY SIZE INTO WS-WARN-TMP
        END-STRING
        MOVE WS-WARN-TMP TO BR-WARNINGS(WS-K)
    END-IF
    .

APPEND-WARN-NO-IMP.
    MOVE SPACES TO WS-WARN-TMP
    IF FUNCTION TRIM(BR-WARNINGS(WS-K)) = SPACES
        MOVE "INSUFFICIENT_COMPLETE_IMPACT_SITES" TO BR-WARNINGS(WS-K)
    ELSE
        STRING FUNCTION TRIM(BR-WARNINGS(WS-K))
               ";INSUFFICIENT_COMPLETE_IMPACT_SITES"
               DELIMITED BY SIZE INTO WS-WARN-TMP
        END-STRING
        MOVE WS-WARN-TMP TO BR-WARNINGS(WS-K)
    END-IF
    INITIALIZE ERR-REQ
    MOVE "ADD" TO EREQ-OP
    MOVE "WARNING" TO EREQ-SEVERITY
    MOVE "INSUFFICIENT_IMPACT_SITES" TO EREQ-CODE
    MOVE "baci-results.csv" TO EREQ-FILE
    MOVE WS-K TO EREQ-ROW
    MOVE BR-SPECIES(WS-K) TO EREQ-FIELD
    STRING "Cannot compute BACI for " FUNCTION TRIM(BR-SPECIES(WS-K))
           " (" FUNCTION TRIM(BR-METHOD(WS-K))
           "): 0 complete IMPACT sites with both PRE and POST observations"
           DELIMITED BY SIZE INTO EREQ-MESSAGE
    END-STRING
    CALL "ERROR-HANDLING" USING ERR-REQ
    .

APPEND-WARN-NO-CTRL.
    MOVE SPACES TO WS-WARN-TMP
    IF FUNCTION TRIM(BR-WARNINGS(WS-K)) = SPACES
        MOVE "INSUFFICIENT_COMPLETE_CONTROL_SITES" TO BR-WARNINGS(WS-K)
    ELSE
        STRING FUNCTION TRIM(BR-WARNINGS(WS-K))
               ";INSUFFICIENT_COMPLETE_CONTROL_SITES"
               DELIMITED BY SIZE INTO WS-WARN-TMP
        END-STRING
        MOVE WS-WARN-TMP TO BR-WARNINGS(WS-K)
    END-IF
    INITIALIZE ERR-REQ
    MOVE "ADD" TO EREQ-OP
    MOVE "WARNING" TO EREQ-SEVERITY
    MOVE "INSUFFICIENT_CONTROL_SITES" TO EREQ-CODE
    MOVE "baci-results.csv" TO EREQ-FILE
    MOVE WS-K TO EREQ-ROW
    MOVE BR-SPECIES(WS-K) TO EREQ-FIELD
    STRING "Cannot compute BACI for " FUNCTION TRIM(BR-SPECIES(WS-K))
           " (" FUNCTION TRIM(BR-METHOD(WS-K))
           "): 0 complete CONTROL sites with both PRE and POST observations"
           DELIMITED BY SIZE INTO EREQ-MESSAGE
    END-STRING
    CALL "ERROR-HANDLING" USING ERR-REQ
    .
